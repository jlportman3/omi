# ----- Vector DB -----
# QDRANT_URL: Qdrant HTTP endpoint. Defaults to the local AMS instance on
# this host. Override when running against a remote / staging cluster.
QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY: leave blank for the local AMS instance (no auth). Set for
# managed Qdrant Cloud.
QDRANT_API_KEY=
# QDRANT_TIMEOUT: seconds for HTTP timeout on Qdrant operations.
QDRANT_TIMEOUT=10

# Pinecone is DEPRECATED — vector store migrated to Qdrant (Mar 2026).
# Leaving these here so legacy operators with cached env files don't break.
# Setting them has no effect on runtime behavior.
PINECONE_API_KEY=
PINECONE_INDEX_NAME=

REDIS_DB_HOST=
REDIS_DB_PORT=
REDIS_DB_PASSWORD=

DEEPGRAM_API_KEY=

# ----- STT Streaming -----
# STT_STREAMING_PROVIDER: select the live-transcription provider.
#   deepgram        (default — uses DEEPGRAM_API_KEY above)
#   realtime-local  (speaches/Realtime API at ws://10.0.60.48:4000/v1/realtime
#                    ?model=whisper-large-v3&intent=transcription; uses OPENAI_API_KEY)
STT_STREAMING_PROVIDER=deepgram
# REALTIME_WS_URL (only used if STT_STREAMING_PROVIDER=realtime-local):
#REALTIME_WS_URL=ws://10.0.60.48:4000/v1/realtime?model=whisper-large-v3&intent=transcription
# REALTIME_TRANSCRIPTION_MODEL:
#REALTIME_TRANSCRIPTION_MODEL=Systran/faster-whisper-large-v3

ADMIN_KEY=
OPENAI_API_KEY=

# ----- Model QoS Profile -----
# MODEL_QOS: selects the active feature→(model, provider) mapping.
#   premium     (default) — gpt-5.4-mini / gpt-4.1-mini / gemini-2.5-flash-lite,
#                            mix of OpenAI direct + Google Gemini direct + OpenRouter
#   max                   — gpt-5.4 across the board, no cost optimization
#   byok                  — same as max (BYOK users pay their own bills)
#   local_only            — fully-local, zero third-party clouds (self-host).
#                            Every feature routes to qwen3.6-35b-a3b on the
#                            local LiteLLM proxy. Eliminates the following
#                            cloud dependencies vs premium/max/byok:
#                              * 5 Gemini-direct tasks: session_titles, followup,
#                                onboarding, app_integration, trends
#                              * 1 OpenRouter task: wrapped_analysis
#                            Caveat: web_search still uses Perplexity cloud
#                            (sonar-pro) — no local equivalent yet. Either
#                            keep PERPLEXITY_API_KEY set or expect web_search
#                            errors. A 'sonar-local' shim (Perplexica behind a
#                            Perplexity-API surface) is tracked separately.
#                            Requires OPENAI_BASE_URL + ANTHROPIC_BASE_URL to
#                            point at the local LiteLLM proxy.
#MODEL_QOS=premium

